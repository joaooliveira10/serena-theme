# What the files in this repository already follow. Editors with EditorConfig support apply it by themselves.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Sample files in exemplos/ keep the usual style of each language.
[*.{cs,java,py}]
indent_size = 4

[*.go]
indent_style = tab
